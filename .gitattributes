# Finales de línea LF en todo el repo (Windows en desarrollo, Linux en el servidor).
# Cada app puede afinar con su propio .gitattributes (p. ej. apps/frontend marca
# src/api/generated/** como linguist-generated).
* text=auto eol=lf

# Scripts de Windows con CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Scripts de shell y SQL siempre LF (se ejecutan dentro de contenedores Linux)
*.sh  text eol=lf
*.sql text eol=lf

# Binarios
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.zip  binary
*.sqlite binary
