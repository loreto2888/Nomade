# =============================================================================
# Nómade — variables del docker-compose.yml LOCAL (solo PostgreSQL)
# Copia este archivo a `.env` (ignorado por git) y cambia los placeholders.
# =============================================================================
#
# Contraseñas: usa valores URL-safe (solo letras, números, '-' y '_'), porque
# van dentro de DATABASE_URL. Por ejemplo:  openssl rand -hex 24
#
# IMPORTANTE: los roles se crean solo al inicializar el volumen por primera
# vez. Si cambias las contraseñas después: `docker compose down -v` (borra la
# BD local) o ALTER ROLE ... PASSWORD ... a mano.

# Puerto del host para PostgreSQL (contenedor: 5432). 5437 también lo declara
# integracion-wom: no levantar ambos a la vez, o cambiarlo aquí.
POSTGRES_PORT=5437

# Superusuario del contenedor (solo administración; las apps no lo usan).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-postgres-local

# Rol dueño del esquema `nomade` (lo usan las migraciones).
NOMADE_OWNER_PASSWORD=cambiar-owner-local

# Rol de la aplicación, solo DML (lo usa el backend).
NOMADE_APP_PASSWORD=cambiar-app-local

# Zona horaria del contenedor (opcional).
# TZ=America/Santiago

# -----------------------------------------------------------------------------
# apps/migrations y apps/backend tienen su PROPIO .env con DATABASE_URL hacia
# localhost:5437, usando ESTAS MISMAS contraseñas:
#
#   apps/migrations/.env
#     DATABASE_URL=postgres://nomade_owner:<NOMADE_OWNER_PASSWORD>@localhost:5437/nomade
#
#   apps/backend/.env
#     DATABASE_URL=postgres://nomade_app:<NOMADE_APP_PASSWORD>@localhost:5437/nomade
# -----------------------------------------------------------------------------
