# =============================================================================
# Nómade — variables del docker-compose.deploy.yml (servidor dell-pc)
# En el servidor:  cp .env.deploy.example .env && chmod 600 .env
# Nunca subas el .env real a git.
# =============================================================================
#
# Contraseñas: DEBEN ser URL-safe (van dentro de DATABASE_URL). Genera cada una con:
#   openssl rand -hex 24
# Los roles se crean solo al inicializar el volumen de postgres por primera vez;
# cambiarlas después requiere ALTER ROLE ... PASSWORD ... y actualizar este .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_openssl_rand_hex_24
NOMADE_OWNER_PASSWORD=CAMBIAR_openssl_rand_hex_24
NOMADE_APP_PASSWORD=CAMBIAR_openssl_rand_hex_24

# --- Web / backend ------------------------------------------------------------
# Puerto publicado por nginx en el servidor (D-16). Cloudflare Tunnel apunta a este puerto.
WEB_PORT=5178
# Origen que el backend acepta (Origin): URL https pública del Cloudflare Tunnel, sin barra final.
APP_ORIGIN=https://nomade.coworlabs.cl
# true: el acceso es siempre por HTTPS (terminado en Cloudflare); la cookie de sesión lleva `Secure`.
COOKIE_SECURE=true
SWAGGER_ENABLED=false
LOG_LEVEL=info

# --- Primer administrador (se crea al arrancar SOLO si no existe ningún usuario) ----
# Contraseña de al menos 12 caracteres. Queda obligada a cambiarse en el primer ingreso.
# Puedes vaciar estas variables después del primer arranque.
ADMIN_EMAIL=admin@cambiar.cl
ADMIN_PASSWORD=CAMBIAR_clave_inicial_de_12+_caracteres
ADMIN_NAME=Administrador

# Solo si se descomenta el puerto de mantención 127.0.0.1:5437 en postgres.
# POSTGRES_PORT=5437

TZ=America/Santiago

# --- Respaldo (servicio backup) ----------------------------------------------
# Carpeta del host donde quedan los respaldos (relativa al repo o absoluta,
# idealmente otro disco/NAS montado).
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
