# =============================================================================
# Nómade — variables del docker-compose.deploy.yml (servidor dell-pc)
# En el servidor:  cp .env.deploy.example .env && chmod 600 .env
# Nunca subas el .env real a git.
# =============================================================================
#
# Contraseñas: DEBEN ser URL-safe (van dentro de DATABASE_URL). Genera cada una con:
#   openssl rand -hex 24
# Los roles se crean solo al inicializar el volumen de postgres por primera vez;
# cambiarlas después requiere ALTER ROLE ... PASSWORD ... y actualizar este .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_openssl_rand_hex_24
NOMADE_OWNER_PASSWORD=CAMBIAR_openssl_rand_hex_24
NOMADE_APP_PASSWORD=CAMBIAR_openssl_rand_hex_24

# --- Web / backend ------------------------------------------------------------
# Puerto publicado por nginx en el servidor (http://dell-pc).
WEB_PORT=80
# Origen que el backend acepta (Origin) y usa para cookies. HTTP solo en LAN.
APP_ORIGIN=http://dell-pc
# false mientras sea HTTP; pasar a true al habilitar HTTPS.
COOKIE_SECURE=false
SWAGGER_ENABLED=false
LOG_LEVEL=info

# Solo si se descomenta el puerto de mantención 127.0.0.1:5437 en postgres.
# POSTGRES_PORT=5437

TZ=America/Santiago

# --- Respaldo (servicio backup) ----------------------------------------------
# Carpeta del host donde quedan los respaldos (relativa al repo o absoluta,
# idealmente otro disco/NAS montado).
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
