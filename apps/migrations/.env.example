# Copia este archivo a apps/migrations/.env (no se commitea).
# node-pg-migrate lo carga con dotenv; una variable ya definida en el entorno tiene prioridad.
#
# Rol nomade_owner (dueño del esquema; ejecuta DDL). Puerto 5437 = PostgreSQL local de docker compose.
# La contraseña debe ser URL-safe (letras, dígitos, - . _ ~) o ir percent-encoded.
# Debe coincidir con NOMADE_OWNER_PASSWORD usado al inicializar el volumen de PostgreSQL.
DATABASE_URL=postgres://nomade_owner:cambiar-owner-local@localhost:5437/nomade
