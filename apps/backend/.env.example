# Copia este archivo como .env (no se commitea) y ajusta los valores.

# development | production | test
NODE_ENV=development
PORT=3007

# Rol nomade_app (solo DML). La contraseña debe ser URL-safe.
# En despliegue: postgres://nomade_app:<pwd>@postgres:5432/nomade
DATABASE_URL=postgres://nomade_app:cambia-esta-clave@localhost:5437/nomade

# Origen público del frontend (sin barra final). Despliegue: https://nomade.coworlabs.cl (URL del túnel)
APP_ORIGIN=http://localhost:5177

# true solo con HTTPS (en el servidor, siempre true; en localhost con http el navegador también acepta `Secure`)
COOKIE_SECURE=false

# Swagger UI en /api/docs y JSON en /api/docs-json
SWAGGER_ENABLED=true

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Directorio de archivos adjuntos (se crea al arrancar si no existe).
# Relativo al directorio de trabajo (apps/backend con npm run dev:backend).
# En la imagen Docker: /data/adjuntos, montado como volumen.
ADJUNTOS_DIR=./data/adjuntos

# Primer administrador: se crea al arrancar solo si no existe ningún usuario.
# La contraseña (mínimo 12 caracteres) queda obligada a cambiarse en el primer ingreso.
# Si se omiten, no se crea ninguno (define las dos o ninguna).
ADMIN_EMAIL=admin@nomade.cl
ADMIN_PASSWORD=cambia-esta-clave-inicial
ADMIN_NAME=Administrador
